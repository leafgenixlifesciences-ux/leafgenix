{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leafgenix",
  "main": ".open-next/worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
