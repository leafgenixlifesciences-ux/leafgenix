# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Used for canonical URLs, sitemap and OG tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google search & measurement -------------------------------------------
# Search Console → Settings → Ownership verification → HTML tag. Paste only
# the value from content="...", not the full meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Tag Manager → Admin → Install Google Tag Manager. Example: GTM-ABC1234.
# Configure the GA4 Google tag (and only any other approved marketing tags) in
# this container. The site intentionally loads nothing while this is blank.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
# GA4 Web Stream Measurement ID. Use this only until the GA4 Google tag is
# moved into the GTM container above; do not set both IDs in production.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# --- Supabase ---------------------------------------------------------------
# Dashboard → Project Settings → Data API  (URL)
# Dashboard → Project Settings → API Keys  (anon / publishable, service_role)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server-only — bypasses row level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---------------------------------------------------------------
# Dashboard → Account & Settings → API Keys.
# Test keys start with rzp_test_, live keys with rzp_live_.
# Both are read on the server at request time, so adding or rotating keys only
# needs a restart — never a rebuild.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → the secret you set when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Lead notification email (Resend) ---------------------------------------
# Create an API key at resend.com and verify the domain used by RESEND_FROM_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=LeafGenix Website <offers@leafgenix.in>
# Where new coupon lead details are delivered. Defaults to the site support email.
LEAD_NOTIFICATION_EMAIL=support@leafpharmaceuticals.in
# Receives contact enquiries and paid-order notifications. Falls back to
# LEAD_NOTIFICATION_EMAIL, then to the support address in src/lib/site.ts.
ADMIN_NOTIFICATION_EMAIL=support@leafpharmaceuticals.in

# --- Admin operations portal ------------------------------------------------
# /admin login. Keep all three server-only and use a unique 32+ character secret.
ADMIN_PORTAL_USERNAME=
ADMIN_PORTAL_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Admin phone push notifications -----------------------------------------
# Generate one VAPID key pair and keep it stable. Set both on the server/Worker;
# the public key is returned only to an authenticated admin browser.
# Apply supabase/migrations/20261019000000_admin_push_subscriptions.sql first.
ADMIN_PUSH_VAPID_PUBLIC_KEY=
ADMIN_PUSH_VAPID_PRIVATE_KEY=

# --- Gupshup WhatsApp (server-only) ----------------------------------------
# Enable only after the LeafGenix WABA is live, migration 20261028000000 is
# applied, recipients have opted in, and the utility templates are approved.
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_PHONE=
GUPSHUP_ADMIN_PHONE=
# Approved template IDs. Parameters: paid [name, order number];
# status [name, order number, status, delivery update];
# admin [order number, customer name, amount].
GUPSHUP_TEMPLATE_ORDER_PAID=
GUPSHUP_TEMPLATE_ORDER_STATUS=
GUPSHUP_TEMPLATE_ADMIN_ORDER=
